# Copy to .env and fill in. Never commit .env.
# Frontend (safe to expose in the browser)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: branding shown before a tenant record loads (after sign-in it comes from the organizations table)
VITE_APP_NAME=RetailHQ VMS
VITE_ORG_NAME=RetailHQ
# Pre-login logo (path under public/ or a URL). Leave empty for the generic mark. Defaults to /brand/slsi-logo.png
# VITE_LOGO_URL=/brand/slsi-logo.png
# VITE_LOGO_DARK_URL=/brand/slsi-logo-white.png
VITE_APP_URL=http://localhost:5173

# Server-side only (scripts, CI). NEVER prefix with VITE_ and never ship to the browser.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_...        # Personal access token: supabase.com/dashboard/account/tokens
SUPABASE_SERVICE_ROLE_KEY=sb_secret_... # Project settings → API keys
